# user ID будет вида @john:dilimour.online
SERVER_NAME=dilimour.online
# сертификат GlobalSign покрывает только dilimour.online и www.dilimour.online:
# Matrix живёт на корне домена, ntfy — на www
MATRIX_HOST=dilimour.online
NTFY_HOST=www.dilimour.online
# setup.sh сгенерирует случайный пароль, если оставить change_me
POSTGRES_PASSWORD=change_me
# бэкапы — на HDD, не на системный SSD
BACKUP_DIR=/mnt/hdd/backups/lifeos-matrix
KEEP_DAYS=14
