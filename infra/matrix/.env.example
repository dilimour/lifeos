# user ID будет вида @john:dilimour.online
SERVER_NAME=dilimour.online
MATRIX_HOST=matrix.dilimour.online
NTFY_HOST=ntfy.dilimour.online
# setup.sh сгенерирует случайный пароль, если оставить change_me
POSTGRES_PASSWORD=change_me
# бэкапы — на HDD, не на системный SSD
BACKUP_DIR=/mnt/hdd/backups/lifeos-matrix
KEEP_DAYS=14
